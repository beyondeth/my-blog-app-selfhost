# Copy to .env.selfhost before starting the self-hosted stack.
# Generate secrets with: openssl rand -hex 32

COMPOSE_PROJECT_NAME=codebase-selfhost
# Keep databases private. Set PUBLIC_BIND_ADDRESS=0.0.0.0 only when a host
# reverse proxy or another device must reach the app ports.
PRIVATE_BIND_ADDRESS=127.0.0.1
PUBLIC_BIND_ADDRESS=127.0.0.1

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-password
POSTGRES_DB=codebase
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_MAX_MEMORY=128mb
REDIS_MAX_MEMORY_POLICY=noeviction

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-password
MINIO_BUCKET=blog
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Public application URLs
FRONTEND_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3001
BACKEND_PUBLIC_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:3000
MCP_BASE_URL=http://localhost:3002
NEXT_PUBLIC_MCP_BASE_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_CDN_BASE_URL=

# Backend security
DB_POOL_SIZE=5
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ISSUER=codebase.selfhost
JWT_AUDIENCE=codebase.selfhost::api
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=replace-with-another-long-secret
MCP_SHARED_SECRET=replace-with-at-least-16-characters
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Optional monitoring profile (not started by the core stack).
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-grafana-password
GRAFANA_ROOT_URL=http://localhost:3030

# Local email mode prints verification codes to the backend log.
# Use smtp for an internet-facing deployment.
EMAIL_MODE=console
EMAIL_FROM=Codebase Blog <noreply@localhost>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional social login providers. Leave blank for local-only auth.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional Cloudflare CDN / R2 / external S3 settings.
CDN_ENABLED=false
# CDN_DOMAIN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
