# ============================================
# MCP Proxy Server 환경 변수 예제
# ============================================
# 이 파일을 .env로 복사하고 실제 값을 입력하세요
# cp .env.example .env

# ============================================
# 서버 설정
# ============================================
PORT=3002
NODE_ENV=development  # development | staging | production
OPENAI_APP_ENABLED=false  # true 시 /mcp-openai 라우트 활성화

# ============================================
# Redis 설정 (Core + Cache)
# ============================================
# Core: OAuth/session storage
REDIS_CORE_HOST=my-blog-app-redis-core
REDIS_CORE_PORT=6379
# Cache: API key caching
REDIS_CACHE_HOST=my-blog-app-redis-cache
REDIS_CACHE_PORT=6379
# Backward-compatible defaults
REDIS_HOST=my-blog-app-redis-core
REDIS_PORT=6379
REDIS_PASSWORD=
API_KEY_CACHE_TTL=300  # API Key 캐시 TTL (초) - 기본 5분

# ============================================
# Backend API 설정 (필수)
# ============================================
BACKEND_BASE_URL=http://localhost:3000  # Backend 서버 기본 URL
BACKEND_API_URL=http://localhost:3000/api/v1  # Backend API URL
BACKEND_PUBLIC_URL=http://localhost:3000  # Backend 공개 URL (브라우저 접근용)
FRONTEND_URL=http://localhost:3001  # 포스트 공개 URL 기준 프론트엔드 주소

# ============================================
# MCP 서버 공개 URL (OAuth 메타데이터용)
# ============================================
# 외부에서 접근 가능한 MCP 프록시 서버의 공개 URL
# OAuth 인증 플로우 및 메타데이터 엔드포인트에서 사용됨
#
# 개발 환경: http://localhost:3002
# 프로덕션: https://www.codebase.blog
#
# ⚠️ 프로덕션에서는 반드시 HTTPS를 사용해야 합니다!
# 설정하지 않으면 환경에 따라 자동 설정됩니다:
# - development: http://localhost:${MCP_PROXY_PORT}
# - production: https://www.codebase.blog
MCP_BASE_URL=http://localhost:3002

# ============================================
# CORS 설정
# ============================================
# 허용할 Origin 목록 (쉼표로 구분)
# 와일드카드(*) 지원: localhost:* 는 localhost의 모든 포트 허용
# ⚠️ 프로덕션 환경에서는 와일드카드(*)를 사용할 수 없습니다!
# 프로덕션 예시: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ============================================
# 로깅 설정
# ============================================
LOG_LEVEL=info  # fatal | error | warn | info | debug | trace
LOG_PRETTY=false  # true로 설정 시 읽기 쉬운 형식으로 출력 (개발용)

# ============================================
# Rate Limiting 설정
# ============================================
RATE_LIMIT_WINDOW_MS=60000  # Rate limit 시간 윈도우 (ms) - 기본 1분
RATE_LIMIT_MAX_REQUESTS=100  # 시간 윈도우 내 최대 요청 수 (개발: 100, 프로덕션: 60 권장)

# ============================================
# MCP Session 설정
# ============================================
MCP_SESSION_TIMEOUT_MS=3600000  # MCP transport 세션 타임아웃 (ms) - 기본 1시간
MCP_MAX_CONCURRENT_SESSIONS=1000  # 최대 동시 활성 세션 수

# ============================================
# Prometheus 메트릭 설정 (프로덕션 권장)
# ============================================
# Prometheus 메트릭 수집 활성화
# GET /metrics 엔드포인트에서 메트릭 노출
# 수집되는 메트릭:
# - HTTP 요청/응답 (요청 수, 응답 시간, 크기)
# - 세션 관리 (활성 세션, 생성/삭제 수, 수명)
# - Redis 작업 (작업 수, 처리 시간, 연결 상태)
# - 에러 추적 (에러 코드별, 상태 코드별)
METRICS_ENABLED=true

# APM (Application Performance Monitoring) 설정 (선택적)
APM_SERVICE_NAME=mcp-proxy-server
APM_SECRET_TOKEN=
APM_SERVER_URL=

# ============================================
# 성능 튜닝 (선택적)
# ============================================
MAX_PAYLOAD_SIZE=10mb  # 최대 요청 페이로드 크기
REQUEST_TIMEOUT=30000  # 요청 타임아웃 (ms)
BACKEND_TIMEOUT=20000  # Backend API 호출 타임아웃 (ms)

# ============================================
# 보안 설정 (선택적)
# ============================================
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=
TRUST_PROXY=false  # 리버스 프록시 뒤에 있을 때 true

# ============================================
# 로컬 포스트 백업 설정 (선택적)
# ============================================
# 블로그 포스트를 로컬 .md 파일로 저장할 디렉토리
# 설정하지 않으면 기본값: ~/Documents/codebase-mcp-posts/
# 파일명 형식: YYYYMMDD_safe-title.md
# Frontmatter 포함 (title, tags, date)
#
# 사용 예시:
# BLOG_POSTS_DIR=/Users/username/Documents/blog-backups
# BLOG_POSTS_DIR=/Users/username/Desktop/my-posts
#
# 이 기능을 사용하면:
# - 포스트 생성 성공 후 자동으로 로컬 파일 저장
# - 버전 관리 및 오프라인 접근 가능
# - 저장 실패해도 포스트 생성은 성공 (non-blocking)
BLOG_POSTS_DIR=
