# Copy to .env for a standalone development process. The root Compose profile
# supplies the same values with Docker service names instead of localhost.

MCP_PROXY_PORT=3002
NODE_ENV=development

BACKEND_BASE_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:3000/api/v1
BACKEND_PUBLIC_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3001
MCP_BASE_URL=http://localhost:3002

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
API_KEY_CACHE_TTL=300

# Required in production and recommended locally.
MCP_SHARED_SECRET=replace-with-at-least-16-characters

# Optional: set a unique bearer token for /metrics and /metrics/stats when the
# proxy is reachable outside the Docker/private network.
# METRICS_AUTH_TOKEN=generate-with-openssl-rand-hex-32

# Use exact trusted origins. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

LOG_LEVEL=info
LOG_PRETTY=true
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=200
REQUEST_TIMEOUT=30000
BACKEND_TIMEOUT=20000
