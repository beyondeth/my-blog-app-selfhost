# ============================================
# MCP Proxy Server 환경 변수 예제
# ============================================
# 이 파일을 .env로 복사하고 실제 값을 입력하세요
# cp .env.example .env

# ============================================
# 서버 설정
# ============================================
PORT=8080
NODE_ENV=development  # development | staging | production

# ============================================
# Redis 설정
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# 세션 설정
# ============================================
SESSION_TTL=86400  # 세션 만료 시간 (초) - 기본 24시간
SESSION_STRICT_MODE=false  # true로 설정 시 IP/User-Agent 변경 검증

# ============================================
# OAuth 설정 (필수)
# ============================================
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REDIRECT_URI=http://localhost:7777/callback

# ============================================
# Backend API 설정 (필수)
# ============================================
BACKEND_BASE_URL=http://localhost:3000  # Backend 서버 기본 URL
BACKEND_API_URL=http://localhost:3000/api/v1  # Backend API URL

# ============================================
# CORS 설정
# ============================================
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ============================================
# 로깅 설정
# ============================================
LOG_LEVEL=info  # fatal | error | warn | info | debug | trace
LOG_PRETTY=false  # true로 설정 시 읽기 쉬운 형식으로 출력 (개발용)

# ============================================
# Rate Limiting (선택적)
# ============================================
RATE_LIMIT_WINDOW_MS=60000  # Rate limit 시간 윈도우 (ms) - 1분
RATE_LIMIT_MAX_REQUESTS=100  # 시간 윈도우 내 최대 요청 수
RATE_LIMIT_MAX_REQUESTS_PER_IP=50  # IP당 최대 요청 수

# ============================================
# 모니터링 (선택적)
# ============================================
METRICS_ENABLED=false
METRICS_PORT=9090
APM_SERVICE_NAME=mcp-proxy-server
APM_SECRET_TOKEN=
APM_SERVER_URL=

# ============================================
# 성능 튜닝 (선택적)
# ============================================
MAX_PAYLOAD_SIZE=10mb  # 최대 요청 페이로드 크기
REQUEST_TIMEOUT=30000  # 요청 타임아웃 (ms)
BACKEND_TIMEOUT=20000  # Backend API 호출 타임아웃 (ms)

# ============================================
# 보안 설정 (선택적)
# ============================================
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=
TRUST_PROXY=false  # 리버스 프록시 뒤에 있을 때 true