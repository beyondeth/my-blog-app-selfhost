# Copy to /etc/aigory-blog/.env.production on the Oracle VM and chmod 600.
# Every value marked SET_IN_SECRET_MANAGER must be supplied through the GitHub production
# environment or generated directly on the server. Never commit real values.

NODE_ENV=production
COMPOSE_PROJECT_NAME=aigory-blog-prod
PORT=3000
TZ=Asia/Seoul

# Public routing
FRONTEND_URL=https://aigory.com
PUBLIC_SITE_URL=https://aigory.com
PUBLIC_BACKEND_URL=https://aigory.com
BACKEND_PUBLIC_URL=https://aigory.com
BACKEND_BASE_URL=http://backend:3000
BACKEND_API_URL=http://backend:3000/api/v1
BACKEND_INTERNAL_URL=http://backend:3000
MCP_BASE_URL=https://mcp.aigory.com
NEXT_PUBLIC_SITE_URL=https://aigory.com
NEXT_PUBLIC_API_URL=https://aigory.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://aigory.com
NEXT_PUBLIC_MCP_BASE_URL=https://mcp.aigory.com
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.aigory.com
NEXT_PUBLIC_STORAGE_PUBLIC_URL=https://cdn.aigory.com
STORAGE_PUBLIC_URL=https://cdn.aigory.com
CDN_DOMAIN=https://cdn.aigory.com
CDN_ENABLED=true

# Browser and reverse-proxy trust
CORS_ALLOWED_ORIGINS=https://aigory.com
CORS_ORIGIN=https://aigory.com
CORS_ORIGINS=https://aigory.com
TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128
SESSION_STORE=redis

# Authentication and internal request signing
JWT_SECRET=SET_IN_SECRET_MANAGER
JWT_REFRESH_SECRET=SET_IN_SECRET_MANAGER
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=aigory.com
JWT_AUDIENCE=aigory.com::api
SESSION_SECRET=SET_IN_SECRET_MANAGER
UPLOAD_INTENT_SECRET=SET_IN_SECRET_MANAGER
MCP_SHARED_SECRET=SET_IN_SECRET_MANAGER
METRICS_AUTH_TOKEN=SET_IN_SECRET_MANAGER
EMAIL_VERIFICATION_HASH_SECRET=SET_IN_SECRET_MANAGER
IP_ENCRYPTION_KEY=SET_IN_SECRET_MANAGER
IP_ENCRYPTION_SALT=SET_IN_SECRET_MANAGER

# Product exposure policy
PAYMENTS_ENABLED=false
MOCK_PAYMENT_ENABLED=false
ADMIN_DEBUG_ENABLED=false

# PostgreSQL 18 through PgBouncer
DB_NAME=aigory_blog_prod
DB_USER=aigory_blog
DB_PASSWORD=SET_IN_SECRET_MANAGER
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000
POSTGRES_DATA_DIR=/mnt/data/aigory-blog/postgres

# PostgreSQL backups in a separate private OCI bucket.
BACKUP_DATA_DIR=/mnt/data/aigory-blog/backups
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_S3_BUCKET=aigory-blog-prod-backups
BACKUP_S3_ACCESS_KEY_ID=SET_IN_SECRET_MANAGER
BACKUP_S3_SECRET_ACCESS_KEY=SET_IN_SECRET_MANAGER
BACKUP_S3_ENDPOINT=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=SET_IN_SECRET_MANAGER
REDIS_URL=redis://:SET_IN_SECRET_MANAGER@redis:6379/0
REDIS_MAX_MEMORY=640mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_DATA_DIR=/mnt/data/aigory-blog/redis

# Private OCI Object Storage
STORAGE_PROVIDER=oci
OCI_NAMESPACE=SET_IN_SECRET_MANAGER
AWS_REGION=ap-singapore-1
AWS_S3_BUCKET=aigory-blog-prod-media
AWS_S3_ACCESS_KEY_ID=SET_IN_SECRET_MANAGER
AWS_S3_SECRET_ACCESS_KEY=SET_IN_SECRET_MANAGER
AWS_S3_FORCE_PATH_STYLE=true
# Browser uploads use the signed OCI compatibility URL. Public reads use CDN.
S3_PUBLIC_ENDPOINT=

# Cloudflare cache purge
CLOUDFLARE_ZONE_ID=SET_IN_SECRET_MANAGER
CLOUDFLARE_API_TOKEN=SET_IN_SECRET_MANAGER

# SMTP and legal operator metadata
EMAIL_MODE=smtp
SMTP_HOST=SET_IN_SECRET_MANAGER
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SET_IN_SECRET_MANAGER
SMTP_PASS=SET_IN_SECRET_MANAGER
EMAIL_FROM=noreply@aigory.com
EMAIL_REPLY_TO=support@aigory.com
OPERATOR_NAME=Aigory
OPERATOR_CONTACT_EMAIL=support@aigory.com
LEGAL_DOCUMENT_VERSION=20260823-v1.0
LEGAL_TERMS_URL=https://aigory.com/legal/terms
LEGAL_PRIVACY_URL=https://aigory.com/legal/privacy

# OAuth provider console callbacks must exactly match these URLs.
REQUIRED_OAUTH_PROVIDERS=GOOGLE,GITHUB,KAKAO
GOOGLE_CLIENT_ID=SET_IN_SECRET_MANAGER
GOOGLE_CLIENT_SECRET=SET_IN_SECRET_MANAGER
GOOGLE_CALLBACK_URL=https://aigory.com/api/v1/auth/google/callback
GITHUB_CLIENT_ID=SET_IN_SECRET_MANAGER
GITHUB_CLIENT_SECRET=SET_IN_SECRET_MANAGER
GITHUB_CALLBACK_URL=https://aigory.com/api/v1/auth/github/callback
KAKAO_CLIENT_ID=SET_IN_SECRET_MANAGER
KAKAO_CLIENT_SECRET=SET_IN_SECRET_MANAGER
KAKAO_CALLBACK_URL=https://aigory.com/api/v1/auth/kakao/callback

# MCP proxy
MCP_PROXY_PORT=3002
API_KEY_CACHE_TTL=300
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=200
REQUEST_TIMEOUT=30000
BACKEND_TIMEOUT=20000
LOG_LEVEL=info
LOG_PRETTY=false

# Optional analytics
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Monitoring
VICTORIAMETRICS_DATA_DIR=/mnt/data/aigory-blog/victoriametrics
GRAFANA_DATA_DIR=/mnt/data/aigory-blog/grafana
GF_SECURITY_ADMIN_USER=aigory-admin
GF_SECURITY_ADMIN_PASSWORD=SET_IN_SECRET_MANAGER
GF_SERVER_ROOT_URL=https://aigory.com/grafana
GF_LOG_LEVEL=warn
