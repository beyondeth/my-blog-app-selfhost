# ============================================
# Codebase 블로그 플랫폼 - 프로덕션 환경 설정 예시
# ============================================
# 🚀 Oracle Cloud Free Tier ARM64 최적화 환경변수
# 🔒 중요: 실제 배포 시 .env.production 파일을 생성하세요
# 📝 배포: docker compose -f docker-compose.prod.oracle.yml up -d --build
# ============================================

# ============================================
# 환경 구분
# ============================================
NODE_ENV=production
COMPOSE_PROJECT_NAME=codebase-prod

# ============================================
# 데이터 볼륨 경로 (Oracle Block Volume)
# ============================================
# 기본 경로: /mnt/data (볼륨 마운트 필요)
# 경로를 변경하려면 아래 환경변수 수정
POSTGRES_DATA_DIR=/mnt/data/postgres
REDIS_DATA_DIR=/mnt/data/redis
VICTORIAMETRICS_DATA_DIR=/mnt/data/victoriametrics
GRAFANA_DATA_DIR=/mnt/data/grafana

# ============================================
# 데이터베이스 (PostgreSQL 18 + PgBouncer)
# ============================================
# PostgreSQL 설정
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
DB_NAME=blog_prod

# 애플리케이션 데이터베이스 URL (PgBouncer 경유)
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@pgbouncer:5432/YOUR_DB_NAME?sslmode=disable

# 마이그레이션 전용 직접 연결
DB_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@postgres:5432/YOUR_DB_NAME?sslmode=disable

# ============================================
# Redis (캐시 + 세션 + 큐)
# ============================================
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=  # 필요 시 설정

# ============================================
# Backend API 서버
# ============================================
BACKEND_URL=http://backend:3000
BACKEND_PORT=3000
PORT=3000

# ============================================
# Frontend (Next.js)
# ============================================
# 공개 URL (실제 도메인으로 변경 필요)
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_DEBUG_MODE=false
FRONTEND_URL=https://your-domain.com

# 분석 도구
NEXT_PUBLIC_MIXPANEL_TOKEN=YOUR_MIXPANEL_TOKEN
NEXT_PUBLIC_GA_MEASUREMENT_ID=YOUR_GA_MEASUREMENT_ID

# ============================================
# MCP Proxy (MCP 자동 포스팅)
# ============================================
MCP_PROXY_PORT=3002
MCP_PROXY_URL=http://mcp-proxy:3002

# Backend 내부 통신용 (Docker 네트워크)
BACKEND_BASE_URL=http://backend:3000
BACKEND_API_URL=http://backend:3000/api/v1

# Backend 공개 URL
BACKEND_PUBLIC_URL=https://your-domain.com

# MCP 서버 공개 URL (HTTPS 필수)
MCP_BASE_URL=https://mcp.your-domain.com

# ============================================
# 인증 설정 (강력한 보안)
# ============================================
# JWT 시크릿 키 (반드시 변경하세요)
JWT_SECRET=YOUR_JWT_SECRET_HERE_MINIMUM_32_CHARS
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_HERE_MINIMUM_64_CHARS

# JWT 만료 시간
JWT_EXPIRES_IN=1d
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
JWT_SESSION_EXPIRES_IN=2h
JWT_CACHE_TTL=5000

# ============================================
# OAuth 소셜 로그인
# ============================================
OAUTH_ACCESS_TOKEN_EXPIRES_IN=86400
OAUTH_REFRESH_TOKEN_EXPIRES_IN=2592000

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# GitHub OAuth
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# Kakao OAuth
KAKAO_CLIENT_ID=YOUR_KAKAO_CLIENT_ID
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET

# ============================================
# 메트릭 및 모니터링
# ============================================
# 내부 헬스 체크 경로
METRICS_PATH=/internal/health-check-2f4a8b9c
METRICS_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1,localhost

# ============================================
# 파일 저장소 (Oracle Object Storage)
# ============================================
# STORAGE_PROVIDER: 'aws' 또는 'oci'
STORAGE_PROVIDER=oci

# Oracle Object Storage 설정
OCI_TENANCY_ID=YOUR_OCI_TENANCY_ID
OCI_USER_ID=YOUR_OCI_USER_ID
OCI_FINGERPRINT=YOUR_OCI_FINGERPRINT
OCI_REGION=ap-seoul-1
OCI_BUCKET_NAME=your-bucket-name
OCI_NAMESPACE=your-namespace

# AWS S3 설정 (STORAGE_PROVIDER=aws 일 때)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket

# ============================================
# 이메일 설정 (SendGrid)
# ============================================
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Codebase Blog

# ============================================
# Stripe 결제
# ============================================
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# 요금제 ID
STRIPE_PRICE_ID_BASIC=price_1xxxxx
STRIPE_PRICE_ID_PRO=price_1xxxxx
STRIPE_PRICE_ID_ENTERPRISE=price_1xxxxx

# ============================================
# Grafana 모니터링
# ============================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=YOUR_GRAFANA_PASSWORD
GF_SERVER_ROOT_URL=https://grafana.your-domain.com
GF_LOG_LEVEL=info

# ============================================
# Nginx 리버스 프록시 설정
# ============================================
# SSL 인증서 경로
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key

# 도메인 설정
DOMAIN_NAME=your-domain.com
WWW_DOMAIN_NAME=www.your-domain.com
API_DOMAIN_NAME=api.your-domain.com
MCP_DOMAIN_NAME=mcp.your-domain.com
GRAFANA_DOMAIN_NAME=grafana.your-domain.com

# ============================================
# 기타 최적화 설정
# ============================================
# PM2 클러스터 워커 수 (CPU 코어 수에 따라 조정)
PM2_INSTANCES=2

# PostgreSQL 연결 풀 설정
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis 최대 메모리 (MB)
REDIS_MAXMEMORY=3500

# 로그 레벨
LOG_LEVEL=info