# ============================================
# Codebase 블로그 플랫폼 - 프로덕션 환경 변수
# ============================================
# 🔒 중요: 이 파일을 .env.production으로 복사 후 실제 값으로 변경하세요
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# ⚠️ 보안: .env.production은 절대 Git에 커밋하지 마세요!
# ============================================

# ==========================================
# Docker Compose 설정
# ==========================================
COMPOSE_PROJECT_NAME=codebase-prod

# ==========================================
# 데이터베이스 (PostgreSQL 18)
# ==========================================
# 데이터베이스 이름
DB_NAME=blog_prod

# 데이터베이스 사용자
DB_USER=postgres

# 데이터베이스 비밀번호 (32자 이상 강력한 비밀번호)
# 생성 방법: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_32_CHARS_OR_MORE

# 데이터베이스 URL (PgBouncer 경유)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@pgbouncer:5432/${DB_NAME}

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ==========================================
# JWT (인증)
# ==========================================
# JWT Secret (32자 이상)
# 생성 방법: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_STRONG_SECRET_32_CHARS_OR_MORE

# JWT 만료 시간
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# ==========================================
# 백엔드 API
# ==========================================
# 포트
BACKEND_PORT=3000

# API Base URL (프론트엔드에서 사용)
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://yourdomain.com

# ==========================================
# MCP Proxy
# ==========================================
MCP_PROXY_PORT=3002

# ==========================================
# AWS S3 (또는 Oracle Object Storage)
# ==========================================
# S3 버킷 이름
AWS_S3_BUCKET=your-oracle-bucket-name

# S3 리전 (오라클 Object Storage의 경우)
# 춘천: ap-chuncheon-1
# 서울: ap-seoul-1
AWS_S3_REGION=ap-chuncheon-1

# S3 Access Key (Oracle Object Storage Customer Secret Keys)
AWS_ACCESS_KEY_ID=your_access_key_id_here

# S3 Secret Key
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# S3 엔드포인트 (Oracle Object Storage)
# 형식: https://{namespace}.compat.objectstorage.{region}.oraclecloud.com
# AWS_S3_ENDPOINT=https://your-namespace.compat.objectstorage.ap-chuncheon-1.oraclecloud.com

# CDN URL (Cloudflare)
# CDN_URL=https://cdn.yourdomain.com

# ==========================================
# OAuth2 (소셜 로그인)
# ==========================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/v1/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=https://yourdomain.com/api/v1/auth/github/callback

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_CALLBACK_URL=https://yourdomain.com/api/v1/auth/kakao/callback

# ==========================================
# 이메일 (SMTP)
# ==========================================
# SMTP 호스트 (예: Gmail, SendGrid, AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false  # TLS

# SMTP 인증
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# 발신자 이메일
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Codebase Blog

# ==========================================
# Stripe (결제)
# ==========================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==========================================
# 도메인 및 CORS
# ==========================================
# 프론트엔드 도메인
FRONTEND_URL=https://yourdomain.com

# CORS 허용 도메인 (쉼표로 구분)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ==========================================
# Grafana
# ==========================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin  # 변경 필수!
GF_LOG_LEVEL=info

# ==========================================
# Node.js 환경
# ==========================================
NODE_ENV=production

# ==========================================
# 기타
# ==========================================
# 타임존 (한국 시간)
TZ=Asia/Seoul

# 로그 레벨 (production: error, warn only)
LOG_LEVEL=info

# ==========================================
# 보안 체크리스트
# ==========================================
# ✅ DB_PASSWORD를 강력한 비밀번호로 변경했는가?
# ✅ JWT_SECRET을 랜덤 문자열로 생성했는가?
# ✅ AWS_ACCESS_KEY_ID와 AWS_SECRET_ACCESS_KEY를 설정했는가?
# ✅ OAuth2 클라이언트 ID/Secret을 발급받았는가?
# ✅ SMTP 인증 정보를 설정했는가?
# ✅ Grafana 관리자 비밀번호를 변경했는가?
# ✅ CORS_ORIGIN에 실제 도메인을 추가했는가?
# ✅ .env.production 파일 권한을 600으로 설정했는가? (chmod 600)
# ✅ .gitignore에 .env.production이 포함되어 있는가?
# ==========================================

# ==========================================
# 환경 변수 검증
# ==========================================
# 필수 환경 변수 확인:
#   - DB_PASSWORD
#   - JWT_SECRET
#   - AWS_S3_BUCKET
#   - AWS_ACCESS_KEY_ID
#   - AWS_SECRET_ACCESS_KEY
#
