# Dependencies
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Production builds
**/dist/
**/.next/
**/build/

# Environment variables (실제 값 포함된 파일들)
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.env.monitoring

# IDE
**/.vscode/
**/.idea/
*.swp
*.swo

# Claude personal settings
.claude/settings.local.json

# MCP client settings (개인 API 키 포함)
.mcp.json

# Codex settings (개인 API 키 포함)
.codex/

# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Logs
*.log
**/logs/
**/*.log

# Runtime data
**/pids/
**/*.pid
**/*.seed
**/*.pid.lock

# Coverage directory used by tools like istanbul
**/coverage/
**/.nyc_output/

# Temporary folders
**/tmp/
**/temp/

# Optional npm cache directory
**/.npm

# Optional eslint cache
**/.eslintcache

# Microbundle cache
**/.rpt2_cache/
**/.rts2_cache_cjs/
**/.rts2_cache_es/
**/.rts2_cache_umd/

# Optional REPL history
**/.node_repl_history

# Output of 'npm pack'
**/*.tgz

# Yarn Integrity file
**/.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
**/.cache
**/.parcel-cache

# Next.js build output
**/.next
**/out

# Nuxt.js build / generate output
**/.nuxt
**/dist

# Gatsby files
**/.cache/
# Public 폴더 무시 (Next.js 빌드 산출물 제외)
/public
backend/public
# Frontend public 폴더 선택적 허용
!frontend/public/assets/**  # Frontend 정적 자산 허용 (로고, 아이콘 등)
!frontend/public/legal/**   # Legal 문서 허용 (버전 관리 필요)
!frontend/public/fonts/**   # 폰트 파일 허용
!frontend/public/character/**  # 캐릭터 이미지 허용

# Storybook build outputs
**/storybook-static

# Temporary files
backend/backend.log
backend/test-image.png
backend/cookies.txt

# Database
**/*.sqlite
**/*.db

# Redis persistence files
*.rdb
*.aof
dump.rdb
appendonly.aof

# Uploads (if storing locally)
**/uploads/

# AWS/S3 config files (keep templates, ignore actual config)
backend/s3-bucket-policy-secure.json
backend/cors-config.json

# Docker volume data (로컬 프로덕션 테스트용)
# postgres, redis, victoriametrics, grafana 데이터 저장 폴더
/data/ 
.env
