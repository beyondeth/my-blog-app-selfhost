
# Specify a custom writing style file path
# If not set, will use the default: writing-styles/default.md
WRITING_STYLE_FILE=writing-styles/tutorial.md

# Blog API Configuration
API_URL=http://localhost:3000/api/v1

# MCP Server URL (통합된 MCP Blog Server)
MCP_SERVER_URL=http://localhost:3002

# OAuth2 Configuration (새로운 인증 방식)
OAUTH_CLIENT_ID=mcp-blog-server
OAUTH_CLIENT_SECRET=mcp-secret-key-2024
OAUTH_REDIRECT_URI=http://localhost:7777/callback
LOCAL_SERVER_PORT=7777

# Blog Posts Directory (TypeScript 서버용)
BLOG_POSTS_DIR=/Users/sihyungpark/Desktop/code/my-blog-app/mcp-blog-server-ts/posts

# Log Level
LOG_LEVEL=info