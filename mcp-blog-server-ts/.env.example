# OAuth2 Configuration
# OAuth2 인증을 위한 환경 변수 설정

# API 서버 URL (백엔드 서버 주소)
API_URL=http://localhost:3000/api/v1

# OAuth2 클라이언트 정보
# 블로그 설정 페이지에서 OAuth 클라이언트를 생성한 후, 아래 정보를 입력하세요
# 1. 블로그 설정 > OAuth 클라이언트 관리 페이지로 이동
# 2. "새 OAuth 클라이언트 생성" 버튼 클릭
# 3. 클라이언트 이름: "MCP Blog Auto-poster" (예시)
# 4. 리다이렉트 URI: http://localhost:7777/callback
# 5. 생성된 클라이언트 ID와 시크릿을 아래에 입력

OAUTH_CLIENT_ID=your-oauth-client-id-here
OAUTH_CLIENT_SECRET=your-oauth-client-secret-here

# OAuth2 리다이렉트 URI (변경하지 마세요)
OAUTH_REDIRECT_URI=http://localhost:7777/callback

# 로컬 서버 포트 (OAuth 콜백을 받기 위한 포트, 변경하지 마세요)
LOCAL_SERVER_PORT=7777

# 로그 레벨 (선택사항: debug, info, warn, error)
LOG_LEVEL=info

# MCP Proxy Server URL (프록시 서버 주소)
# MCP 클라이언트가 연결할 중앙 프록시 서버
PROXY_SERVER_URL=http://localhost:3002

# Writing Style 파일 경로 (선택사항)
# 글쓰기 스타일 템플릿 파일 경로
WRITING_STYLE_FILE=writing-styles/tutorial.md

# 블로그 포스트 저장 디렉토리 (선택사항)
# 생성된 마크다운 파일이 저장될 디렉토리
# - 상대 경로 사용 시: 패키지 루트 디렉토리 기준 (권장)
#   예: ./posts, ./blog-posts, ./content
# - 절대 경로도 사용 가능하지만 npm 배포 시 문제 발생 가능
#   예: /Users/username/my-blog/posts (권장하지 않음)
# - 설정하지 않으면 기본값: ./posts
BLOG_POSTS_DIR=./posts