# MCP Blog Server TypeScript Environment Configuration

# Writing Style Configuration
# Specify a custom writing style file path
# If not set, will use the default: writing-styles/default.md
# WRITING_STYLE_FILE=writing-styles/marketing-style.md
# WRITING_STYLE_FILE=writing-styles/technical-style.md
# WRITING_STYLE_FILE=writing-styles/casual-style.md

# API Configuration
BLOG_API_URL=http://localhost:3000/api/v1
BLOG_API_KEY_ID=akid_your_api_key_id_here
BLOG_API_KEY_SECRET=aks_your_api_key_secret_here

# Legacy API Key Support (if not using new format)
BLOG_API_KEY=sk_your_legacy_api_key_here

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/mcp-server.log
ENABLE_CONSOLE_LOGGING=true
ENABLE_FILE_LOGGING=false

# Security Configuration
REQUEST_TIMEOUT=30000
MAX_REQUEST_SIZE=10485760
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Performance Configuration
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_TTL=300000

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30000

# Development Configuration
ENABLE_DEBUG_LOGS=false
ENABLE_PROFILING=false
ENABLE_SOURCE_MAPS=true

# Docker Configuration
DOCKER_NETWORK=mcp-network
CONTAINER_MEMORY_LIMIT=512m
CONTAINER_CPU_LIMIT=0.5

# Kubernetes Configuration
K8S_NAMESPACE=mcp-blog-server
K8S_SERVICE_ACCOUNT=mcp-blog-server
K8S_REPLICA_COUNT=3

# Database Configuration (if needed in future)
# DATABASE_URL=postgresql://user:password@localhost:5432/mcp_blog
# DATABASE_SSL=false
# DATABASE_POOL_SIZE=10

# Redis Configuration (if needed for caching)
# REDIS_URL=redis://localhost:6379
# REDIS_TTL=3600

# Alerting Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERT_EMAIL_TO=admin@yourdomain.com
ALERT_EMAIL_FROM=alerts@yourdomain.com

# AWS Configuration (if deploying to AWS)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# ECS_CLUSTER=mcp-cluster
# ECS_SERVICE=mcp-blog-server

# Load Balancer Configuration
LB_HEALTH_CHECK_PATH=/health
LB_HEALTH_CHECK_TIMEOUT=5000
LB_SESSION_AFFINITY=false

# SSL/TLS Configuration
ENABLE_HTTPS=false
SSL_CERT_PATH=./certs/server.crt
SSL_KEY_PATH=./certs/server.key
SSL_CA_PATH=./certs/ca.crt