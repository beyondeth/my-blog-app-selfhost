# 한국 미러를 사용한 빠른 패키지 다운로드
registry=https://registry.npmmirror.com

# 타임아웃 설정 (180초)
fetch-timeout=180000

# 잠금 파일 엄격 적용 (빌드 안정성)
frozen-lockfile=true

# 피어 의존성 체크 완화 (빌드 속도)
strict-peer-dependencies=false

# 네트워크 동시성 (Oracle FreeTier 최적화)
network-concurrency=3

# 재시도 횟수 증가 (안정성)
fetch-retries=5

# 재시도 최소/최대 대기 시간
fetch-retry-mintimeout=1000
fetch-retry-maxtimeout=10000

# 캐시 디렉토리 서버 최적화
cache-dir=/home/ubuntu/.pnpm-store
global-dir=/home/ubuntu/.pnpm-global

# 불필요한 패키지 건너뛰기 (빌드 속도) - Oracle ARM64에서는 필수
# ignore-optional=true

# 빌드 스크립트 건너뛰기 (설치 시간 단축)
ignore-scripts=false

# libs 검사 건너뛰기
skip-libs=false