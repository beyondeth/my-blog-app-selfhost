{
  "name": "@codebase/mcp-blog-client",
  "version": "2.0.0",
  "description": "Lightweight MCP client for blog posting via proxy server",
  "main": "dist/index.js",
  "bin": {
    "mcp-blog-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:http": "node dist/index.js --transport http --port 3001",
    "setup": "node setup-claude.js",
    "postinstall": "echo '\\n🚀 MCP Blog Server 설치 완료!\\n실행: npm run setup 으로 Claude Desktop 설정을 시작하세요\\n'",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "clean": "rm -rf dist coverage node_modules/.cache",
    "clean:all": "rm -rf dist coverage node_modules"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.2",
    "commander": "^14.0.0",
    "dotenv": "^16.4.5",
    "marked": "^14.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.19.1",
    "typescript": "^5.8.2",
    "vitest": "^2.0.5"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "blog",
    "oauth2",
    "authentication"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/mcp-blog-server-ts.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}