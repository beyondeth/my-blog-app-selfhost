# Blog MCP Server 보안 강화 환경 설정
# ~/.blog-mcp/.env 파일에 복사하여 사용

# ========================================
# 기본 API 설정
# ========================================
BLOG_API_URL=http://localhost:3000

# ========================================
# 1단계 인증: 이메일/패스워드
# ========================================
# 세션 유지: 2시간 (기본 인증)
BLOG_EMAIL=mcp-user@example.com
BLOG_PASSWORD=McpPass123

# ========================================
# 2단계 인증: API 키 (중요!)
# ========================================
# 세션 유지: 24시간 (전체 인증)
# ⚠️ 보안 주의: 이 키는 절대 공유하거나 Git에 커밋하지 마세요
BLOG_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# 선택 사항: 고급 보안 설정
# ========================================
# Rate Limiting (분당 요청 제한, 기본값: 60)
# BLOG_RATE_LIMIT=60

# 세션 타임아웃 (초 단위, 기본값: 86400 = 24시간)
# BLOG_SESSION_TIMEOUT=86400

# IP 화이트리스트 (쉼표로 구분, 비활성화 시 모든 IP 허용)
# BLOG_ALLOWED_IPS=127.0.0.1,192.168.1.100

# 감사 로그 활성화 (기본값: true)
# BLOG_AUDIT_LOG=true