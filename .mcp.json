{
  "mcpServers": {
    "codebase_blog": {
      "type": "stdio",
      "command": "node",
      "args": ["/Users/sihyungpark/Desktop/code/my-blog-app/mcp-blog-server-ts/dist/index.js"],
      "env": {
        "PROXY_SERVER_URL": "http://localhost:3002"
      }
    },
    "postgres": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "crystaldba/postgres-mcp",
        "--access-mode=unrestricted"
      ]
    },
    "redis-mcp-server": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/uvx",
      "args": [
        "--from",
        "redis-mcp-server@latest",
        "redis-mcp-server",
        "--url",
        "redis://localhost:6379/0"
      ]
    }
  }
}