/* 
 * Markdown CSS
 * 백엔드에서 생성된 마크다운 HTML 클래스 스타일
 * 디자인 시스템 토큰 활용
 */

@layer markdown {
  /* ============================
     제목 (Headings)
     ============================ */
  .markdown-h1 {
    @apply text-3xl font-bold mb-6 mt-8;
    color: rgb(var(--color-gray-900));
    line-height: var(--leading-tight);
  }
  
  .markdown-h2 {
    @apply text-2xl font-bold mb-4 mt-6;
    color: rgb(var(--color-gray-800));
    line-height: var(--leading-tight);
  }
  
  .markdown-h3 {
    @apply text-xl font-semibold mb-3 mt-5;
    color: rgb(var(--color-gray-800));
    line-height: var(--leading-tight);
  }
  
  .markdown-h4 {
    @apply text-lg font-semibold mb-3 mt-4;
    color: rgb(var(--color-gray-700));
  }
  
  .markdown-h5 {
    @apply text-base font-medium mb-2 mt-3;
    color: rgb(var(--color-gray-700));
  }
  
  .markdown-h6 {
    @apply text-sm font-medium mb-2 mt-3;
    color: rgb(var(--color-gray-600));
  }
  
  /* 모바일 반응형 */
  @media (max-width: 640px) {
    .markdown-h1 { @apply text-2xl; }
    .markdown-h2 { @apply text-xl; }
    .markdown-h3 { @apply text-lg; }
  }
  
  /* ============================
     본문 (Paragraph)
     ============================ */
  .markdown-p, .markdown-paragraph {
    @apply my-4;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: rgb(var(--color-gray-700));
    word-break: break-word;
  }
  
  /* ============================
     코드 블록 (Code Blocks)
     ============================ */
  .markdown-code-block {
    @apply my-6 rounded-lg overflow-x-auto;
    background: rgb(var(--color-code-bg)) !important;
    color: rgb(var(--color-code-text)) !important;
    padding: var(--space-lg);
    box-shadow: var(--shadow-code-block);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    transition: all var(--duration-normal) var(--easing-ease-out);
  }
  
  .markdown-code-block:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-1px);
  }
  
  .markdown-code-block code {
    background: transparent !important;
    color: inherit !important;
    padding: 0 !important;
    font-family: inherit;
    font-size: inherit;
  }
  
  /* 인라인 코드 */
  .markdown-inline-code {
    @apply px-1 py-0.5 rounded;
    background: rgb(var(--color-gray-100));
    color: rgb(var(--color-gray-800));
    font-family: var(--font-mono);
    font-size: 0.875em;
    word-break: break-word;
  }
  
  /* ============================
     링크 (Links)
     ============================ */
  .markdown-link {
    @apply inline-flex items-center px-1 py-0.5 rounded transition-all;
    color: rgb(var(--color-sky-500));
    background-color: rgb(var(--color-sky-50));
    text-decoration: none;
    border-bottom: 2px solid transparent;
    word-break: break-word;
  }
  
  .markdown-link:hover {
    color: rgb(var(--color-sky-600));
    background-color: rgb(var(--color-sky-100));
    border-bottom-color: rgb(var(--color-sky-500));
  }
  
  .markdown-external-link {
    @apply inline-flex items-center px-1 py-0.5 rounded transition-all;
    color: rgb(var(--color-sky-500));
    background-color: rgb(var(--color-sky-50));
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  
  .markdown-external-link:hover {
    color: rgb(var(--color-sky-600));
    background-color: rgb(var(--color-sky-100));
    border-bottom-color: rgb(var(--color-sky-500));
  }
  
  /* 외부 링크 아이콘 */
  .markdown-external-icon {
    @apply inline-block w-3 h-3 ml-1;
    vertical-align: baseline;
    opacity: 0.7;
    transition: opacity var(--duration-fast);
  }
  
  .markdown-external-link:hover .markdown-external-icon {
    opacity: 1;
  }
  
  /* ============================
     테이블 (Tables)
     ============================ */
  .markdown-table {
    @apply w-full my-6 border-collapse;
    box-shadow: var(--shadow-sm);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  
  .markdown-table-header {
    @apply px-4 py-3 text-left font-semibold;
    background: rgb(var(--color-gray-100));
    color: rgb(var(--color-gray-800));
    border-bottom: 2px solid rgb(var(--color-gray-200));
  }
  
  .markdown-table-cell {
    @apply px-4 py-3;
    color: rgb(var(--color-gray-700));
    border-bottom: 1px solid rgb(var(--color-gray-100));
  }
  
  .markdown-table tr:last-child .markdown-table-cell {
    border-bottom: none;
  }
  
  .markdown-table tbody tr:hover {
    background: rgb(var(--color-gray-50));
  }
  
  /* 모바일 반응형 테이블 */
  @media (max-width: 640px) {
    .markdown-table {
      font-size: var(--text-sm);
    }
    
    .markdown-table-header,
    .markdown-table-cell {
      @apply px-2 py-2;
    }
  }
  
  /* ============================
     리스트 (Lists)
     ============================ */
  .markdown-ul {
    @apply my-4 pl-6;
    list-style-type: disc;
    color: rgb(var(--color-gray-700));
  }
  
  .markdown-ol {
    @apply my-4 pl-6;
    list-style-type: decimal;
    color: rgb(var(--color-gray-700));
  }
  
  .markdown-li {
    @apply my-2;
    line-height: var(--leading-relaxed);
  }
  
  /* 중첩 리스트 스타일 */
  .markdown-ul .markdown-ul {
    list-style-type: circle;
    margin-top: var(--space-sm);
  }
  
  .markdown-ul .markdown-ul .markdown-ul {
    list-style-type: square;
  }
  
  .markdown-ol .markdown-ol {
    list-style-type: lower-alpha;
    margin-top: var(--space-sm);
  }
  
  /* ============================
     인용문 (Blockquotes)
     ============================ */
  .markdown-blockquote {
    @apply my-6 pl-4 pr-4 py-3 border-l-4 rounded-r-lg;
    border-left-color: rgb(var(--color-gray-400));
    background: rgb(var(--color-gray-50));
    color: rgb(var(--color-gray-600));
    font-style: italic;
    line-height: var(--leading-relaxed);
  }
  
  .markdown-blockquote p {
    margin: 0;
  }
  
  /* ============================
     구분선 (Horizontal Rule)
     ============================ */
  .markdown-hr {
    @apply my-8 border-0 border-t-2;
    border-color: rgb(var(--color-gray-200));
  }
  
  /* ============================
     이미지 (Images)
     ============================ */
  .markdown-image {
    @apply max-w-full h-auto my-6 rounded-lg;
    box-shadow: var(--shadow-md);
    transition: all var(--duration-normal) var(--easing-ease-out);
    cursor: pointer;
  }
  
  .markdown-image:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-lg);
  }
  
  /* 모바일에서 이미지 최적화 */
  @media (max-width: 640px) {
    .markdown-image {
      max-height: 60vh;
      object-fit: contain;
    }
  }
  
  /* ============================
     VSCode Dark+ 신택스 하이라이팅
     ============================ */
  
  /* 기본 토큰 */
  .prose .hljs-keyword,
  .markdown-code-block .hljs-keyword {
    color: #569cd6 !important;
  }
  
  .prose .hljs-string,
  .markdown-code-block .hljs-string {
    color: #ce9178 !important;
  }
  
  .prose .hljs-comment,
  .markdown-code-block .hljs-comment {
    color: #6a9955 !important;
    font-style: italic;
  }
  
  .prose .hljs-function,
  .prose .hljs-title.function_,
  .markdown-code-block .hljs-function,
  .markdown-code-block .hljs-title.function_ {
    color: #dcdcaa !important;
  }
  
  .prose .hljs-variable,
  .prose .hljs-property,
  .markdown-code-block .hljs-variable,
  .markdown-code-block .hljs-property {
    color: #9cdcfe !important;
  }
  
  .prose .hljs-number,
  .prose .hljs-literal,
  .markdown-code-block .hljs-number,
  .markdown-code-block .hljs-literal {
    color: #b5cea8 !important;
  }
  
  .prose .hljs-type,
  .prose .hljs-built_in,
  .markdown-code-block .hljs-type,
  .markdown-code-block .hljs-built_in {
    color: #4ec9b0 !important;
  }
  
  .prose .hljs-meta,
  .markdown-code-block .hljs-meta {
    color: #c586c0 !important;
  }
  
  .prose .hljs-operator,
  .prose .hljs-punctuation,
  .markdown-code-block .hljs-operator,
  .markdown-code-block .hljs-punctuation {
    color: #d4d4d4 !important;
  }
  
  /* 언어별 특화 스타일은 기존 globals.css의 스타일을 유지 */
  
  /* ============================
     컨테이너 스타일
     ============================ */
  .prose {
    max-width: none;
    color: rgb(var(--color-text));
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
  }
  
  /* 다크 모드 지원 */
  @media (prefers-color-scheme: dark) {
    .markdown-p,
    .markdown-paragraph {
      color: rgb(var(--color-gray-300));
    }
    
    .markdown-inline-code {
      background: rgb(var(--color-gray-800));
      color: rgb(var(--color-gray-200));
    }
    
    .markdown-blockquote {
      background: rgb(var(--color-gray-800));
      border-left-color: rgb(var(--color-gray-600));
      color: rgb(var(--color-gray-400));
    }
    
    .markdown-table-header {
      background: rgb(var(--color-gray-800));
      color: rgb(var(--color-gray-200));
    }
    
    .markdown-table tbody tr:hover {
      background: rgb(var(--color-gray-800));
    }
  }
}