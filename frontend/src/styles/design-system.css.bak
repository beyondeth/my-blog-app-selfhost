/* 
 * Design System CSS
 * 통합 디자인 토큰 및 시스템
 * 백엔드에서 생성된 마크다운 HTML을 위한 스타일 정의
 */

@layer design-system {
  /* ============================
     색상 시스템 (Color System) 
     ============================ */
  :root {
    /* Primary Colors - 회색 계열 */
    --color-gray-50: 249 250 251;
    --color-gray-100: 243 244 246;
    --color-gray-200: 229 231 235;
    --color-gray-300: 209 213 219;
    --color-gray-400: 156 163 175;
    --color-gray-500: 107 114 128;
    --color-gray-600: 75 85 99;
    --color-gray-700: 55 65 81;
    --color-gray-800: 31 41 55;
    --color-gray-900: 17 24 39;
    
    /* Accent Colors - 하늘색 계열 */
    --color-sky-50: 240 249 255;
    --color-sky-100: 224 242 254;
    --color-sky-200: 186 230 253;
    --color-sky-300: 125 211 252;
    --color-sky-400: 56 189 248;
    --color-sky-500: 14 165 233;
    --color-sky-600: 2 132 199;
    --color-sky-700: 3 105 161;
    --color-sky-800: 7 89 133;
    --color-sky-900: 12 74 110;
    
    /* Code Block - VSCode Dark+ 테마 */
    --color-code-bg: 30 30 30;        /* #1e1e1e */
    --color-code-text: 248 248 248;   /* #f8f8f8 */
    --color-code-keyword: 86 156 214; /* #569cd6 */
    --color-code-string: 206 145 120; /* #ce9178 */
    --color-code-comment: 106 153 85; /* #6a9955 */
    --color-code-function: 220 220 170; /* #dcdcaa */
    
    /* Semantic Colors */
    --color-success: 34 197 94;
    --color-warning: 251 146 60;
    --color-error: 239 68 68;
    --color-info: 59 130 246;
  }
  
  /* ============================
     타이포그래피 (Typography)
     ============================ */
  :root {
    /* Font Families */
    --font-sans: 'Pretendard Variable', 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
    --font-mono: 'GeistMono', 'Fira Code', 'Monaco', 'Menlo', 'Consolas', monospace;
    
    /* Font Sizes - Mobile First */
    --text-xs: 0.75rem;    /* 12px */
    --text-sm: 0.875rem;   /* 14px */
    --text-base: 1rem;     /* 16px */
    --text-lg: 1.125rem;   /* 18px */
    --text-xl: 1.25rem;    /* 20px */
    --text-2xl: 1.5rem;    /* 24px */
    --text-3xl: 1.875rem;  /* 30px */
    --text-4xl: 2.25rem;   /* 36px */
    
    /* Line Heights */
    --leading-tight: 1.25;
    --leading-normal: 1.5;
    --leading-relaxed: 1.7;
    --leading-loose: 2;
    
    /* Font Weights */
    --font-normal: 400;
    --font-medium: 500;
    --font-semibold: 600;
    --font-bold: 700;
  }
  
  /* ============================
     간격 시스템 (Spacing) 
     ============================ */
  :root {
    /* 4px 기반 스케일 */
    --space-xs: 0.25rem;   /* 4px */
    --space-sm: 0.5rem;    /* 8px */
    --space-md: 1rem;      /* 16px */
    --space-lg: 1.5rem;    /* 24px */
    --space-xl: 2rem;      /* 32px */
    --space-2xl: 3rem;     /* 48px */
    --space-3xl: 4rem;     /* 64px */
  }
  
  /* ============================
     그림자 시스템 (Shadows)
     ============================ */
  :root {
    --shadow-none: none;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    --shadow-2xl: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    --shadow-code-block: 0 4px 6px rgba(0, 0, 0, 0.15);
  }
  
  /* ============================
     보더 시스템 (Borders)
     ============================ */
  :root {
    /* Border Radius */
    --radius-none: 0;
    --radius-sm: 0.125rem;
    --radius-md: 0.375rem;
    --radius-lg: 0.5rem;
    --radius-xl: 0.75rem;
    --radius-2xl: 1rem;
    --radius-full: 9999px;
    
    /* Border Width */
    --border-0: 0;
    --border-1: 1px;
    --border-2: 2px;
    --border-4: 4px;
  }
  
  /* ============================
     애니메이션 (Animation)
     ============================ */
  :root {
    /* Duration */
    --duration-fast: 150ms;
    --duration-normal: 200ms;
    --duration-slow: 300ms;
    
    /* Easing */
    --easing-linear: linear;
    --easing-ease-in: cubic-bezier(0.4, 0, 1, 1);
    --easing-ease-out: cubic-bezier(0, 0, 0.2, 1);
    --easing-ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* ============================
     다크 모드 지원
     ============================ */
  @media (prefers-color-scheme: dark) {
    :root {
      /* 다크 모드에서 색상 반전 */
      --color-bg: var(--color-gray-900);
      --color-text: var(--color-gray-100);
      --color-border: var(--color-gray-700);
    }
  }
  
  /* 라이트 모드 기본값 */
  :root {
    --color-bg: 255 255 255;
    --color-text: var(--color-gray-900);
    --color-border: var(--color-gray-200);
  }
}