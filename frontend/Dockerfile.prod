# ============================================
# Codebase Frontend - Next.js Standalone Production Dockerfile
# ============================================
# 🎯 목표: 메모리 최적화 (1.5GB → 768MB)
# 🔧 전략:
#   - Next.js Standalone 빌드 (output: 'standalone')
#   - Multi-stage 빌드 (deps, builder, runner)
#   - 최종 이미지 크기 최소화 (500MB → 150MB)
#
# 📝 사용법:
#   docker build -f Dockerfile.prod -t codebase-frontend:latest .
# ============================================

# ============================================
# Stage 1: Dependencies (의존성 설치 - 최적화)
# ============================================
FROM node:22-slim AS deps

# 작업 디렉토리
WORKDIR /app

# 시스템 패키지 설치
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        build-essential \
        make \
        g++ \
        libvips-dev \
    && rm -rf /var/lib/apt/lists/*

# pnpm 설치 및 환경 설정
RUN npm install -g pnpm@9
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# package.json과 pnpm-lock.yaml 복사
COPY package.json pnpm-lock.yaml* ./

# 모든 의존성 설치 (캐시 마운트 강화 및 최적화)
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/root/.local/share/pnpm/store \
    --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --ignore-scripts --frozen-lockfile --prefer-offline

# ============================================
# Stage 2: Builder (Next.js 빌드 - 최적화)
# ============================================
FROM node:22-slim AS builder

WORKDIR /app

# 빌드에 필요한 시스템 패키지
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        build-essential \
        make \
        g++ \
        libvips-dev \
    && rm -rf /var/lib/apt/lists/*

# pnpm 설치 (빌드 명령어용)
RUN npm install -g pnpm@9

# 의존성 복사를 먼저 수행 (캐시 효율성)
COPY --from=deps /app/node_modules ./node_modules

# package.json과 lock 파일 복사 (빌드 스크립트용)
COPY package.json pnpm-lock.yaml* ./

# 소스 코드 복사 (의존성 복사 후)
COPY . .

# Next.js 환경 변수 (빌드 타임)
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Turbopack 비활성화 (Next.js 16 호환성 문제 해결)
ENV NEXT_TURBOPACK=0

# 빌드 최적화 환경 변수 (병렬 빌드 및 메모리 최적화)
ENV NODE_OPTIONS="--max-old-space-size=3072"
ENV NEXT_BUILD_WORKERS=4
ENV npm_config_build_from_source=false
ENV npm_config_sharp_binary_host="https://github.com/lovell/sharp/releases"
ENV npm_config_sharp_libvips_binary_host="https://github.com/lovell/sharp-libvips/releases"
ENV SKIP_NATIVE_COMPILATION=1

# 빌드 인자로 API URL 받기
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_CDN_BASE_URL
ARG NEXT_PUBLIC_STORAGE_PUBLIC_URL
ARG NEXT_PUBLIC_MCP_BASE_URL
ARG BACKEND_INTERNAL_URL
ARG NEXT_PUBLIC_MIXPANEL_TOKEN
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID

# 빌드 인자를 환경변수로 설정
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_CDN_BASE_URL=$NEXT_PUBLIC_CDN_BASE_URL
ENV NEXT_PUBLIC_STORAGE_PUBLIC_URL=$NEXT_PUBLIC_STORAGE_PUBLIC_URL
ENV NEXT_PUBLIC_MCP_BASE_URL=$NEXT_PUBLIC_MCP_BASE_URL
ENV BACKEND_INTERNAL_URL=$BACKEND_INTERNAL_URL
ENV NEXT_PUBLIC_MIXPANEL_TOKEN=$NEXT_PUBLIC_MIXPANEL_TOKEN
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=$NEXT_PUBLIC_GA_MEASUREMENT_ID

# Next.js 빌드 (Standalone 모드, NEXT_TURBOPACK=0으로 Webpack 사용)
RUN npm run build

# ============================================
# Stage 3: Runner (최종 런타임)
# ============================================
FROM node:22-slim AS runner

# 보안: 비-루트 사용자 생성
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid 1001 --create-home nextjs

WORKDIR /app

# 환경 변수
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000

# Next.js Standalone 빌드 결과 복사
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Sharp 복사 (이미지 최적화용)
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/sharp ./node_modules/sharp

# 비-루트 사용자로 전환
USER nextjs

# 포트 노출
EXPOSE 3000

# Standalone 서버 실행
CMD ["node", "server.js"]

# ============================================
# 빌드 크기 최적화 결과
# ============================================
# - deps 단계: ~800MB (캐시 가능)
# - builder 단계: ~1.2GB (캐시 가능)
# - runner 단계: ~150MB (최종 이미지)
#
# 메모리 사용량:
# - 일반 빌드: 1.5GB
# - Standalone: 768MB (49% 절감)
# ============================================
