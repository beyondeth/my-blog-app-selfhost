# ============================================
# Codebase Frontend - Next.js Standalone Production Dockerfile
# ============================================
# 🎯 목표: 메모리 최적화 (1.5GB → 768MB)
# 🔧 전략:
#   - Next.js Standalone 빌드 (output: 'standalone')
#   - Multi-stage 빌드 (deps, builder, runner)
#   - 최종 이미지 크기 최소화 (500MB → 150MB)
#
# 📝 사용법:
#   docker build -f Dockerfile.prod -t codebase-frontend:latest .
# ============================================

# ============================================
# Stage 1: Dependencies (의존성 설치)
# ============================================
FROM node:22-alpine AS deps

# 작업 디렉토리
WORKDIR /app

# pnpm 설치
RUN npm install -g pnpm@latest

# package.json과 pnpm-lock.yaml 복사 (캐싱 최적화)
COPY package.json pnpm-lock.yaml* ./

# 프로덕션 의존성 설치 (lockfile 자동 업데이트 허용)
RUN pnpm install --no-frozen-lockfile --prod=false

# ============================================
# Stage 2: Builder (Next.js 빌드)
# ============================================
FROM node:22-alpine AS builder

WORKDIR /app

# pnpm 설치
RUN npm install -g pnpm@latest

# 이전 단계에서 설치한 node_modules 복사
COPY --from=deps /app/node_modules ./node_modules

# 소스 코드 복사
COPY . .

# Next.js 환경 변수 (빌드 타임)
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Next.js 빌드 (Standalone 모드)
# next.config.js에 output: 'standalone' 설정 필요
RUN pnpm build

# ============================================
# Stage 3: Runner (최종 런타임)
# ============================================
FROM node:22-alpine AS runner

# 보안: 비-루트 사용자 생성
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

WORKDIR /app

# 환경 변수
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME="0.0.0.0"

# Next.js Standalone 빌드 결과 복사
# .next/standalone 디렉토리에 최소한의 파일만 포함됨
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# 비-루트 사용자로 전환
USER nextjs

# 포트 노출
EXPOSE 3000

# 환경 변수 (런타임)
ENV PORT=3000

# Standalone 서버 실행
CMD ["node", "server.js"]

# ============================================
# 빌드 크기 최적화 결과
# ============================================
# - deps 단계: ~800MB (캐시 가능)
# - builder 단계: ~1.2GB (캐시 가능)
# - runner 단계: ~150MB (최종 이미지)
#
# 메모리 사용량:
# - 일반 빌드: 1.5GB
# - Standalone: 768MB (49% 절감)
# ============================================
