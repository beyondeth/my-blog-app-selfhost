/* Tiptap Editor Styles */

/* 에디터 컨테이너 */
.ProseMirror {
  min-height: 200px;
  padding: 1rem;
  outline: none;
}

.ProseMirror:focus {
  outline: none;
}

/* 플레이스홀더 */
.ProseMirror p.is-editor-empty:first-child::before {
  content: attr(data-placeholder);
  color: #adb5bd;
  pointer-events: none;
  height: 0;
  float: left;
}

/* 이미지 리사이징 관련 스타일 */
.resizable-image-wrapper {
  position: relative;
  display: inline-block;
  max-width: 100%;
  margin: 8px 0;
}

.resizable-image-wrapper:hover .react-resizable-handle {
  opacity: 1 !important;
}

.resizable-image-wrapper.selected {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
  border-radius: 4px;
}

.resizable-image-wrapper.resizing {
  user-select: none;
}

.resizable-image-container {
  position: relative;
  overflow: hidden;
  border-radius: 4px;
}

/* React Resizable 커스텀 스타일 오버라이드 */
.react-resizable {
  position: relative;
  display: inline-block;
}

.react-resizable-handle {
  position: absolute;
  width: 20px;
  height: 20px;
  background-repeat: no-repeat;
  background-origin: content-box;
  box-sizing: border-box;
  background-image: none;
  background-position: center;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.react-resizable-handle:hover {
  transform: scale(1.2);
}

.react-resizable-handle-se {
  bottom: 0;
  right: 0;
  cursor: se-resize;
  background: linear-gradient(135deg, transparent 50%, #3b82f6 50%);
  border-radius: 0 0 4px 0;
}

/* 코드 블록 스타일 */
.ProseMirror pre {
  background: #282c34;
  color: #abb2bf;
  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  overflow-x: auto;
}

.ProseMirror code {
  background: rgba(#616161, 0.1);
  color: #616161;
  padding: 0.2rem 0.4rem;
  border-radius: 0.25rem;
  font-size: 0.875rem;
}

/* 헤딩 스타일 */
.ProseMirror h1 {
  font-size: 2rem;
  font-weight: 700;
  margin: 1.5rem 0 1rem;
}

.ProseMirror h2 {
  font-size: 1.5rem;
  font-weight: 600;
  margin: 1.25rem 0 0.75rem;
}

.ProseMirror h3 {
  font-size: 1.25rem;
  font-weight: 600;
  margin: 1rem 0 0.5rem;
}

/* 리스트 스타일 */
.ProseMirror ul,
.ProseMirror ol {
  padding-left: 1.5rem;
  margin: 0.75rem 0;
}

.ProseMirror li {
  margin: 0.25rem 0;
}

/* 링크 스타일 */
.ProseMirror a {
  color: #3b82f6;
  text-decoration: underline;
  cursor: pointer;
}

.ProseMirror a:hover {
  color: #2563eb;
}

/* 인용문 스타일 */
.ProseMirror blockquote {
  border-left: 4px solid #e5e7eb;
  padding-left: 1rem;
  margin: 1rem 0;
  color: #6b7280;
  font-style: italic;
}

/* 하이라이트 */
.ProseMirror mark {
  background-color: #fef3c7;
  padding: 0.125rem 0;
  border-radius: 0.125rem;
}

/* 텍스트 정렬 */
.ProseMirror p[style*="text-align: center"] {
  text-align: center;
}

.ProseMirror p[style*="text-align: right"] {
  text-align: right;
}

.ProseMirror p[style*="text-align: justify"] {
  text-align: justify;
}

/* 슬래시 커맨드 메뉴 */
.slash-command-menu {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 0.5rem;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  padding: 0.5rem 0;
  max-height: 300px;
  overflow-y: auto;
}

.slash-command-item {
  padding: 0.5rem 1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.slash-command-item:hover,
.slash-command-item.selected {
  background: #f3f4f6;
}

/* 리셋 버튼 스타일 */
.image-reset-button {
  position: absolute;
  top: 8px;
  left: 8px;
  padding: 4px 8px;
  background: rgba(59, 130, 246, 0.9);
  color: white;
  font-size: 12px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-weight: 500;
  white-space: nowrap;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: background 0.2s, transform 0.1s;
  user-select: none;
  z-index: 10;
}

.image-reset-button:hover {
  background: rgba(59, 130, 246, 1);
  transform: scale(1.05);
}

.image-reset-button:active {
  transform: scale(0.98);
}

/* 크기 표시 스타일 */
.image-size-display {
  position: absolute;
  top: 8px;
  right: 8px;
  padding: 4px 8px;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  font-size: 12px;
  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
  border-radius: 4px;
  pointer-events: none;
  user-select: none;
  z-index: 5;
}

/* 리사이징 중 크기 표시 */
.image-resize-indicator {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 8px 12px;
  background: rgba(0, 0, 0, 0.8);
  color: white;
  font-size: 14px;
  font-weight: bold;
  border-radius: 4px;
  pointer-events: none;
  user-select: none;
  z-index: 10;
}

/* 리사이즈 핸들 인디케이터 */
.resize-handle-indicator {
  position: absolute;
  bottom: 5px;
  right: 5px;
  width: 20px;
  height: 20px;
  background: linear-gradient(135deg, transparent 50%, #3b82f6 50%);
  border-radius: 0 0 4px 0;
  opacity: 0;
  transition: opacity 0.2s;
  pointer-events: none;
}

.resize-handle-indicator.visible {
  opacity: 1;
}

/* 이미지 스타일 */
.resizable-image {
  display: block;
  border-radius: 4px;
  user-select: none;
  pointer-events: auto;
}

.resizable-image.selected {
  border: 2px solid #3b82f6;
}

/* 모바일 반응형 */
@media (max-width: 640px) {
  .resizable-image-wrapper {
    max-width: 100%;
  }
  
  .react-resizable-handle {
    width: 24px;
    height: 24px;
  }
  
  .image-reset-button {
    font-size: 11px;
    padding: 3px 6px;
  }
  
  .image-size-display {
    font-size: 11px;
    padding: 3px 6px;
  }
}

/* YouTube iframe 스타일 */
.youtube-video,
[data-youtube-video] {
  position: relative;
  width: 100%;
  max-width: 640px;
  margin: 1rem auto;
  display: block;
}

.youtube-video iframe,
[data-youtube-video] iframe {
  width: 100%;
  height: 100%;
  border: none;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

/* 에디터 내 YouTube 컨테이너 */
.ProseMirror .youtube-video,
.ProseMirror [data-youtube-video] {
  position: relative;
  width: 100%;
  max-width: 640px;
  height: 360px; /* 16:9 비율로 고정 높이 설정 */
  margin: 1.5rem auto; /* 가운데 정렬 */
  border-radius: 8px;
  overflow: hidden;
}

.ProseMirror .youtube-video iframe,
.ProseMirror [data-youtube-video] iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
  background: white; /* iframe 배경을 흰색으로 */
}

/* 반응형 처리 */
@media (max-width: 768px) {
  .ProseMirror .youtube-video,
  .ProseMirror [data-youtube-video] {
    max-width: 100%;
    height: 0;
    padding-bottom: 56.25%; /* 모바일에서는 반응형 비율 사용 */
  }
}

/* 다크모드 지원 */
@media (prefers-color-scheme: dark) {
  .ProseMirror {
    color: #e5e7eb;
  }
  
  .ProseMirror p.is-editor-empty:first-child::before {
    color: #6b7280;
  }
  
  .resizable-image-wrapper.selected {
    outline-color: #60a5fa;
  }
  
  .react-resizable-handle-se {
    background: linear-gradient(135deg, transparent 50%, #60a5fa 50%);
  }
  
  .slash-command-menu {
    background: #1f2937;
    border-color: #374151;
  }
  
  .slash-command-item:hover,
  .slash-command-item.selected {
    background: #374151;
  }
  
  .youtube-video iframe {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
}