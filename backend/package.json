{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "clean": "rm -rf dist",
    "clean:build": "npm run clean && npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:migrations": "jest --runInBand migrations/migration-manifest.spec.ts",
    "test:quality": "jest --runInBand app.module.release.spec.ts auth/auth.service.spec.ts auth/auth.controller.mcp-oauth.spec.ts auth/guards/oauth-state.util.spec.ts config/environment.config.spec.ts email/email.service.spec.ts files/files.service.upload-complete.spec.ts common/utils/url-sanitizer.util.spec.ts common/utils/readiness.util.spec.ts common/guards/internal-mcp.guard.spec.ts common/guards/csrf.guard.spec.ts common/services/idempotency.service.spec.ts common/services/outbox.service.spec.ts common/session/session-config.util.spec.ts common/session/redis-session.store.spec.ts organizations/guards/organization-context.guard.spec.ts communities/guards/community-resource-scope.guard.spec.ts communities/services/community-post.service.spec.ts chat/services/chat.service.security.spec.ts chat/repositories/message.repository.security.spec.ts chat/gateways/chat.gateway.security.spec.ts rate-limit/rate-limit.guard.spec.ts commands/create-admin.command.spec.ts commands/promote-admin.command.spec.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:mcp": "node test-mcp-api.js",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d ./src/data-source.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./src/data-source.ts",
    "migration:run:prod": "npm run clean:build && node ./node_modules/typeorm/cli.js migration:run -d ./dist/src/data-source.js",
    "migration:run:prod:nobuild": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/src/data-source.js",
    "migration:run:script": "npm run clean:build && ./scripts/run-migrations.sh",
    "migration:run:docker": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/src/data-source.js",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./src/data-source.ts",
    "migration:revert:prod": "node ./node_modules/typeorm/cli.js migration:revert -d ./dist/src/data-source.js",
    "migration:check": "ts-node -r tsconfig-paths/register scripts/check-migrations.ts",
    "tenant:orphan-check": "ts-node -r tsconfig-paths/register scripts/check-organization-orphans.ts",
    "migration:status": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d ./src/data-source.ts",
    "migration:status:prod": "node ./node_modules/typeorm/cli.js migration:show -d ./dist/src/data-source.js",
    "admin:create": "node dist/src/commands/create-admin.command.js",
    "admin:create:dev": "ts-node -r tsconfig-paths/register src/commands/create-admin.command.ts",
    "admin:promote": "node dist/src/commands/promote-admin.command.js",
    "admin:promote:dev": "ts-node -r tsconfig-paths/register src/commands/promote-admin.command.ts",
    "migrate:files": "ts-node -r tsconfig-paths/register scripts/migrate-files.ts",
    "migrate:files:dry": "ts-node -r tsconfig-paths/register scripts/migrate-files.ts --dry-run",
    "migrate:files:execute": "ts-node -r tsconfig-paths/register scripts/migrate-files.ts --execute",
    "seed:subscription-plans": "ts-node -r tsconfig-paths/register src/commands/seed-subscription-plans.command.ts"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "@types/ejs",
      "@types/mjml",
      "@types/pug",
      "ejs",
      "handlebars",
      "liquidjs",
      "mjml",
      "preview-email",
      "pug"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "@types/ejs",
        "@types/mjml",
        "@types/pug",
        "ejs",
        "liquidjs",
        "mjml",
        "preview-email",
        "pug"
      ]
    },
    "overrides": {
      "glob": "10.5.0",
      "jws": "3.2.3",
      "validator": "13.15.35",
      "minimatch@>=9 <10": "9.0.7",
      "minimatch@>=5 <6": "5.1.8",
      "minimatch@<4": "3.1.5",
      "brace-expansion@>=2 <3": "2.1.4",
      "brace-expansion@<2": "1.1.18",
      "socket.io-parser": "4.2.7",
      "engine.io": "6.6.9",
      "path-to-regexp@<1": "0.1.13",
      "lodash": "4.18.1",
      "ws": "8.21.3",
      "js-cookie": "3.0.8",
      "form-data": "4.0.6",
      "js-yaml": "4.3.1",
      "postcss": "8.5.23",
      "nanoid@<4": "3.3.18",
      "sha.js": "2.4.12",
      "fast-xml-parser": "5.7.0",
      "handlebars": "4.7.9",
      "liquidjs": "10.27.1",
      "multer": "2.2.0",
      "file-type": "21.3.2",
      "sanitize-html>htmlparser2": "10.1.0",
      "uuid": "11.1.1",
      "@smithy/config-resolver": "4.7.2",
      "body-parser": "1.20.6",
      "diff": "4.0.4",
      "dompurify": "3.4.13",
      "isomorphic-dompurify>jsdom": "26.1.0",
      "morgan": "1.11.0",
      "on-headers": "1.1.0",
      "passport-oauth2": "1.8.0",
      "qs": "6.15.3"
    }
  },
  "keywords": [],
  "packageManager": "pnpm@9.0.0",
