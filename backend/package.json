{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "clean": "rm -rf dist",
    "clean:build": "npm run clean && npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:mcp": "node test-mcp-api.js",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d ./src/data-source.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./src/data-source.ts",
    "migration:run:prod": "npm run clean:build && node ./node_modules/typeorm/cli.js migration:run -d ./dist/src/data-source.js",
    "migration:run:prod:nobuild": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/src/data-source.js",
    "migration:run:script": "npm run clean:build && ./scripts/run-migrations.sh",
    "migration:run:docker": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/src/data-source.js",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./src/data-source.ts",
    "migration:revert:prod": "node ./node_modules/typeorm/cli.js migration:revert -d ./dist/src/data-source.js",
    "migration:check": "ts-node -r tsconfig-paths/register scripts/check-migrations.ts",
    "migration:status": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d ./src/data-source.ts",
    "migration:status:prod": "node ./node_modules/typeorm/cli.js migration:show -d ./dist/src/data-source.js",
    "migrate:files": "ts-node -r tsconfig-paths/register scripts/migrate-files.ts",
    "migrate:files:dry": "ts-node -r tsconfig-paths/register scripts/migrate-files.ts --dry-run",
    "migrate:files:execute": "ts-node -r tsconfig-paths/register scripts/migrate-files.ts --execute",
    "seed:subscription-plans": "ts-node -r tsconfig-paths/register src/commands/seed-subscription-plans.command.ts"
  },
  "keywords": [],
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.832.0",
    "@aws-sdk/lib-storage": "^3.832.0",
    "@aws-sdk/s3-request-presigner": "^3.832.0",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^7.1.0",
    "@nestjs/terminus": "^10.2.6",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^11.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/express-session": "^1.18.2",
    "@types/hbs": "^4.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/lru-cache": "^7.10.10",
    "@types/marked": "^6.0.0",
    "@types/node-fetch": "2",
    "@types/passport-github2": "^1.2.9",
    "@types/sanitize-html": "^2.16.0",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^10.0.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.5",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-store": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "express-session": "^1.18.2",
    "hbs": "^4.2.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.7.0",
    "isomorphic-dompurify": "^2.28.0",
    "jsdom": "^27.0.0",
    "lru-cache": "^11.2.1",
    "marked": "^16.2.1",
    "mime-types": "^3.0.1",
    "morgan": "^1.10.1",
    "multer": "1.4.5-lts.2",
    "music-metadata": "^10.9.1",
    "nanoid": "^5.1.6",
    "node-fetch": "2",
    "nodemailer": "^7.0.5",
    "passport": "^0.6.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-kakao": "^1.0.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.17",
    "uuid": "^11.1.0",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/cache-manager-redis-store": "^3.0.0",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^7.0.0",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/passport-jwt": "^3.0.9",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "chalk": "^4.1.2",
    "dotenv": "^17.2.1",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
