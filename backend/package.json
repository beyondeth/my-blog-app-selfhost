    "hbs": "^4.2.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.7.0",
    "ipaddr.js": "^2.3.0",
    "isomorphic-dompurify": "2.28.0",
    "jsdom": "26.1.0",
    "lru-cache": "^11.2.1",
    "marked": "^16.2.1",
    "mime-types": "^3.0.1",
    "morgan": "^1.11.0",
    "multer": "2.2.0",
    "music-metadata": "11.12.3",
