    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/express-session": "^1.18.2",
    "@types/hbs": "^4.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/lru-cache": "^7.10.10",
    "@types/marked": "^6.0.0",
