<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="42dp"
        android:paddingBottom="26dp">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/login_logo_content_desc"
            android:src="@drawable/ic_codebase_logo_clean" />

        <TextView
            android:id="@+id/logoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.005"
            android:text="@string/login_logo_text"
            android:textColor="#F3F7FF"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/login_subtitle"
            android:textColor="#9CB2CB"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_email_label"
                android:textColor="#B8C7DA"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="none"
                app:expandedHintEnabled="false"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/login_input_background"
                    android:gravity="center_vertical"
                    android:hint="@string/login_email_hint"
                    android:includeFontPadding="false"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp"
                    android:textColor="#F6FAFF"
                    android:textColorHint="#9CB1CA"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/login_password_label"
                android:textColor="#B8C7DA"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="none"
                app:expandedHintEnabled="false"
                app:endIconMode="password_toggle"
                app:endIconTint="#AFC2D9"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/login_input_background"
                    android:gravity="center_vertical"
                    android:hint="@string/login_password_hint"
                    android:includeFontPadding="false"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp"
                    android:textColor="#F6FAFF"
                    android:textColorHint="#9CB1CA"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/login_button_primary"
            android:backgroundTint="@android:color/transparent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/login_action"
            android:textAllCaps="false"
            android:textColor="@color/login_button_primary_text"
            android:textSize="17sp"
            app:backgroundTint="@android:color/transparent"
            app:icon="@android:drawable/ic_dialog_email"
            app:iconPadding="10dp"
            app:iconTint="#E6F1FF"
            app:strokeWidth="0dp" />

        <TextView
            android:id="@+id/loginStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/login_status_idle"
            android:textColor="#9AB0C9"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/loginProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateTint="#98C7FF"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:text="@string/login_forgot_password"
            android:textColor="#59B5FF"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/socialRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@drawable/login_divider_line" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:text="@string/login_divider_or"
                android:textColor="#829AB6"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@drawable/login_divider_line" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/googleLoginButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/login_button_social"
            android:backgroundTint="@android:color/transparent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/login_google"
            android:textAllCaps="false"
            android:textColor="#F2F7FF"
            android:textSize="17sp"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_google_g"
            app:iconPadding="10dp"
            app:iconTint="@null"
            app:iconSize="18dp"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/githubLoginButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/login_button_social"
            android:backgroundTint="@android:color/transparent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/login_github"
            android:textAllCaps="false"
            android:textColor="#F2F7FF"
            android:textSize="17sp"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_github_mark_vector"
            app:iconPadding="10dp"
            app:iconTint="@null"
            app:iconSize="18dp"
            app:strokeWidth="0dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_horizontal"
            android:text="@string/login_register_prompt"
            android:textColor="#8FA5C0"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
