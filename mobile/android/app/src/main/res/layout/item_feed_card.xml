<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feedCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="sans-serif"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/feedAuthorAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_avatar_circle"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/feedAuthorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/MyBlogTextTitleMedium"
                    android:textColor="@color/myblog_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/feedMetaText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    style="@style/MyBlogTextMeta"
                    android:textColor="@color/myblog_text_secondary"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/feedOverflowAction"
                    android:layout_width="0dp"
                    android:layout_height="18dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/feed_more_desc"
                    android:paddingStart="10dp"
                    android:paddingEnd="2dp"
                    android:scaleType="fitEnd"
                    android:src="@drawable/ic_myblog_more"
                    android:tint="@color/myblog_icon_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/feedTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/MyBlogTextTitleMedium"
                android:textColor="@color/myblog_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/feedExcerptText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2sp"
                android:maxLines="4"
                style="@style/MyBlogTextBodyMedium"
                android:textColor="@color/myblog_text_body"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/feedThumbnailImage"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_post_image_rounded"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/feedActionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/feedLikeAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:id="@+id/feedLikeIconImage"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_myblog_like_outline"
                        android:tint="@color/myblog_icon_muted" />

                    <TextView
                        android:id="@+id/feedLikeCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minWidth="18dp"
                        style="@style/MyBlogTextMeta"
                        android:textColor="@color/myblog_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feedCommentAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_myblog_comment"
                        android:tint="@color/myblog_icon_muted" />

                    <TextView
                        android:id="@+id/feedCommentCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minWidth="18dp"
                        style="@style/MyBlogTextMeta"
                        android:textColor="@color/myblog_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feedRepostAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_myblog_repost"
                        android:tint="@color/myblog_icon_muted" />

                    <TextView
                        android:id="@+id/feedRepostCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minWidth="18dp"
                        style="@style/MyBlogTextMeta"
                        android:textColor="@color/myblog_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feedShareAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_myblog_share"
                        android:tint="@color/myblog_icon_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/myblog_divider" />
</LinearLayout>
