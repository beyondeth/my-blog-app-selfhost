<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/myblog_background"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/sheetComposeCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sheet_compose_cancel"
            android:textColor="@color/myblog_text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/sheet_compose_title"
            android:textColor="@color/myblog_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheetComposeSubmit"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="76dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_filter_chip_unselected"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@string/compose_publish"
            android:textAllCaps="false"
            android:textColor="@color/myblog_text_secondary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/myblog_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/sheetComposeAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_avatar_circle"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheetComposeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/myblog_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/sheetComposeInput"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="@string/compose_body_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="0dp"
                android:textColor="@color/myblog_text_primary"
                android:textColorHint="@color/myblog_text_secondary"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/sheetComposeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/myblog_text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
