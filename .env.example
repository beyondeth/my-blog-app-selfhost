# ============================================
# Codebase 블로그 플랫폼 - 환경변수 템플릿
# ============================================
# 이 파일을 복사하여 사용하세요:
#   개발 환경: cp .env.example .env.development
#   프로덕션: cp .env.example .env.production
#
# ⚠️ 주의사항:
# - 실제 값을 입력한 .env 파일은 절대 Git에 커밋하지 마세요
# - 프로덕션 환경에서는 반드시 강력한 랜덤 키를 사용하세요
# - OAuth 클라이언트 ID/Secret은 각 환경에 맞게 설정하세요
# ============================================

# ============================================
# 환경 구분
# ============================================
NODE_ENV=development                    # development | production
COMPOSE_PROJECT_NAME=codebase-dev       # codebase-dev | codebase-prod

# ============================================
# 데이터베이스
# ============================================
# 개발: 로컬 PostgreSQL 컨테이너
# 프로덕션: AWS RDS
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_URL=postgresql://user:password@host:5432/dbname
DB_HOST=postgres                        # 개발: postgres | 프로덕션: RDS 엔드포인트
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=blog-dev                        # 개발: blog-dev | 프로덕션: blog-db

# ============================================
# Redis (공유 인스턴스)
# ============================================
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                         # 비어있음 (개발환경에서는 비밀번호 없음)

# ============================================
# Backend
# ============================================
BACKEND_URL=http://backend:3000
BACKEND_PORT=3000
PORT=3000

# ============================================
# Frontend
# ============================================
# 개발: localhost:3000, localhost:3001
# 프로덕션: 실제 도메인으로 변경 필수
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_DEBUG_MODE=true             # 개발: true | 프로덕션: false
FRONTEND_URL=http://localhost:3001

# ============================================
# MCP Proxy
# ============================================
MCP_PROXY_PORT=3002
MCP_PROXY_URL=http://mcp-proxy:3002
BACKEND_BASE_URL=http://backend:3000
BACKEND_API_URL=http://backend:3000/api/v1

# ============================================
# JWT (⚠️ 프로덕션에서는 강력한 랜덤 키 필수!)
# ============================================
# 생성 방법: openssl rand -hex 64
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-this-in-production
JWT_EXPIRES_IN=1d
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
JWT_SESSION_EXPIRES_IN=2h
JWT_CACHE_TTL=5000

# ============================================
# OAuth Token Configuration
# ============================================
OAUTH_ACCESS_TOKEN_EXPIRES_IN=86400
OAUTH_REFRESH_TOKEN_EXPIRES_IN=2592000
OAUTH_CLIENT_ID=mcp-proxy-client
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:3002/oauth/callback

# ============================================
# Metrics Security
# ============================================
METRICS_PATH=/internal/health-check-2f4a8b9c
METRICS_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1,localhost

# ============================================
# AWS S3
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
NEXT_PUBLIC_S3_BUCKET=your-s3-bucket-name
NEXT_PUBLIC_AWS_REGION=us-east-1

# ============================================
# OAuth (각 환경에 맞게 설정)
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_CALLBACK_URL=http://localhost:3000/api/v1/auth/kakao/callback

# ============================================
# Email (Gmail SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password      # Gmail 앱 비밀번호 사용
SMTP_FROM="Your Blog Name <noreply@yourdomain.com>"

# Email Verification Settings
EMAIL_VERIFICATION_EXPIRES_IN=5
EMAIL_VERIFICATION_MAX_ATTEMPTS=3
EMAIL_RATE_LIMIT_PER_MINUTE=1
EMAIL_RATE_LIMIT_PER_DAY=5
EMAIL_CODE_MIN=100000
EMAIL_CODE_MAX=999999
EMAIL_COPYRIGHT_YEAR=2025

# ============================================
# CDN
# ============================================
CDN_ENABLED=true
CDN_DOMAIN=your-cloudfront-domain.cloudfront.net
CDN_DISTRIBUTION_ID=your-cloudfront-distribution-id
CDN_IMAGE_TRANSFORM=false
CDN_SIGNED_URLS=false
CDN_SIGNED_COOKIES=false
CDN_BATCH_SIZE=3000

# ============================================
# CORS
# ============================================
# 개발: localhost 허용
# 프로덕션: 실제 도메인으로 변경
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ============================================
# Encryption (⚠️ 프로덕션에서는 강력한 랜덤 키 필수!)
# ============================================
# 생성 방법: openssl rand -hex 32 (KEY), openssl rand -hex 16 (SALT)
ENCRYPTION_KEY=your-encryption-key-64-chars-hex
ENCRYPTION_SALT=your-encryption-salt-32-chars-hex

# ============================================
# Security & Rate Limiting
# ============================================
MCP_TIMESTAMP_WINDOW=300000
MCP_RATE_LIMIT_BLOCK_DURATION=300000
API_KEY_TIMESTAMP_WINDOW=300000

# ============================================
# Database Timeouts
# ============================================
DB_CACHE_DURATION=30000
DB_CONNECTION_TIMEOUT=3000
DB_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# ============================================
# S3 & CDN URL Patterns
# ============================================
S3_URL_PATTERN=https://{bucket}.s3.{region}.amazonaws.com/{key}
CDN_URL_PATTERN=https://{domain}/{path}
YOUTUBE_THUMBNAIL_URL=https://img.youtube.com/vi/{id}/maxresdefault.jpg

# ============================================
# Pagination
# ============================================
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# ============================================
# Debug Flags
# ============================================
# 개발: true/false | 프로덕션: false
DEBUG_CHAT=false
DEBUG_FOLLOW=false

# ============================================
# MCP Proxy Settings
# ============================================
SESSION_TTL=86400
SESSION_STRICT_MODE=false               # 개발: false | 프로덕션: true
SESSION_ENCRYPTION_KEY=your-session-encryption-key-64-chars-hex
MCP_SESSION_TIMEOUT_MS=3600000
MCP_MAX_CONCURRENT_SESSIONS=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100             # 개발: 100 | 프로덕션: 60
MAX_PAYLOAD_SIZE=10mb
REQUEST_TIMEOUT=30000
BACKEND_TIMEOUT=20000
LOG_LEVEL=debug                         # 개발: debug | 프로덕션: info
LOG_PRETTY=true                         # 개발: true | 프로덕션: false

# MCP Resources - Allowed Roots
# 개발: 로컬 경로 | 프로덕션: 서버 경로
MCP_ROOTS_ALLOWED_DIRS=/path/to/your/codebase,/path/to/your/documents

# ============================================
# Timezone
# ============================================
TZ=Asia/Seoul
